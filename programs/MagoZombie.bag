
creatures:

creature Wizard {

    known HP hp;

    known Damage ignis() {
        narrate "Lo stregone lancia Ignis!";
        return roll d6;
    }

    known Damage acidSpray() {
        narrate "Lo stregone usa Spruzzo Acido!";
        return roll d8;
    }

    known Bool holdPerson() {

        narrate "Lo stregone tenta Blocca Persone!";

        Int wizardRoll = (roll d6) + 3;
        Int zombieRoll = (roll d8) + 1;

        narrate i"Tiro stregone: ${wizardRoll}";
        narrate i"Tiro zombie: ${zombieRoll}";

        if (wizardRoll gte zombieRoll) {
            narrate "Lo zombie rimane paralizzato!";
            return true;
        }
        else {
            narrate "Lo zombie resiste!";
            return false;
        }
    }
}

creature Zombie {

    known HP hp;

    known Damage bite() {
        narrate "Lo zombie morde!";
        return roll d6;
    }
}



quest:
{

    Wizard mage = summon Wizard();

    Zombie zombie1 = summon Zombie();

    mage.hp = 50;

    zombie1.hp = 30;

    Bool secondZombieSummoned = false;

    Zombie zombie2 = summon Zombie();
    zombie2.hp = 20;

    Int blockedTurns = 0;

    narrate "=== INIZIO BATTAGLIA ===";

    until ((mage.hp lte 0) or
          ((zombie1.hp lte 0) and
          ((secondZombieSummoned eq false) or (zombie2.hp lte 0)))) {

        narrate "----------------";

        // =========================
        // TURNO MAGO
        // =========================

        Int action = roll d6;

        Damage mageDamage = 0;

        Bool targetZombie2 = false;

        // il secondo zombie può essere colpito
        // solo se il primo è morto

        if ((zombie1.hp lte 0) and (secondZombieSummoned eq true)) {
            targetZombie2 = true;
        }

        //action = 9; //per testare default

        switch (action) {

            case 1:
            case 2:




                narrate "Il mago sceglie Ignis";

                mageDamage = mage.cast ignis();

                break;

            case 4:
            case 3:

                narrate "Il mago sceglie Spruzzo Acido";

                mageDamage = mage.cast acidSpray();

                break;

            case 5:
            case 6:

                narrate "Il mago prova Blocca Persone";

                Bool blocked = mage.cast holdPerson();

                if (blocked eq true) {

                    blockedTurns = 2;
                }

                else {

                    if (secondZombieSummoned eq false) {

                        narrate "Lo zombie chiama un alleato!";

                        secondZombieSummoned = true;
                    }
                }

                break;

           default:

                   narrate "[ERORRE : fuori dal range]";
        }

        // =========================
        // APPLICA DANNI MAGO
        // =========================

        if (mageDamage gt 0) {

            if (targetZombie2 eq true) {

                zombie2.hp = zombie2.hp - mageDamage;

                narrate i"Zombie 2 subisce ${mageDamage} danni!";
                narrate i"HP Zombie2: ${zombie2.hp}";
            }

            else {

                zombie1.hp = zombie1.hp - mageDamage;

                narrate i"Zombie 1 subisce ${mageDamage} danni!";
                narrate i"HP Zombie1: ${zombie1.hp}";
            }
        }

        // =========================
        // TURNO ZOMBIE 1
        // =========================

        if (zombie1.hp gt 0) {

            if (blockedTurns gt 0) {

                narrate "Zombie 1 è paralizzato!";

                blockedTurns = blockedTurns - 1;
            }

            else {

                Damage zombieAtk = zombie1.cast bite();

                mage.hp = mage.hp - zombieAtk;

                narrate i"Il mago subisce ${zombieAtk} danni!";
            }
        }

        // =========================
        // TURNO ZOMBIE 2
        // =========================

        if ((secondZombieSummoned eq true) and (zombie2.hp gt 0)) {

            Damage zombieAtk2 = zombie2.cast bite();

            mage.hp = mage.hp - zombieAtk2;

            narrate i"Zombie alleato infligge ${zombieAtk2} danni!";
        }

        // =========================
        // DEBUG HP
        // =========================

        narrate i"HP MAGO: ${mage.hp}";
    }

    narrate "=== FINE BATTAGLIA ===";

    if (mage.hp lte 0) {
        narrate "Il mago è stato sconfitto...";
    }
    else {
        narrate "Il mago ha vinto!";
    }
}

