
creatures:

    creature Warrior {
        known HP hp;
        known Damage attack;

        known void Scream() {
            narrate "Attack!";
        }

    }

spellbook:

    spell Void initWarrior(Warrior w, HP hp, Damage dmg) {
        w.hp = hp;
        w.attack = dmg;
    }

    spell Int sum(Int a, Int b) {
        return a + b;
    }

    spell Damage Fireball(Int base){
        return (Damage)base + roll 1d6; // return roll 1d6 + base non funziona, deve essere invertito, serve (damage) prima di roll perchè deve ritornare un tipo:Damage, normalmente returna Int e da errore TypeMismatch
    }

quest:
{
    narrate "Spell per inizializzare Warrior con hp e dmg - funziona!";

    Warrior w = summon Warrior();
    w.cast Scream();                                              //prova funzione void

    cast initWarrior(w, (HP)30, (Damage)10);                    //prova spell initWarrior, il warrior w prende i valori hp e attack da qui, è necessario un warrior già summonato
    narrate i"WARRIOR HP:${w.hp}, ATTACK:${w.attack}";


    Int somma = cast sum(3, 5);                                //prove con spell - nb: cast è necessario!
    narrate i"SOMMA ${somma}";

    Damage Fireball = cast Fireball(10);
    narrate i"PALLA DI FUOCO ${Fireball}";
    narrate Fireball; //<-----si può scrivere direttamente

    Damage dmg = (Damage)roll 2d8;                              //Damage dmg = roll 2d8; da errore mismatch

    Int x = 10;                                                // Damage d = 5;  --> [TypeCheck] line 49:4 – Cannot assign Int to variable of type Damage
    Damage d = (Damage)5;
    x = d;

    Float x = 10;
    Int x = (Int) 10.7;

    Int x = 1 + 2 * 3; //=9, non rispetta l'ordine modificare doc**
    narrate x;


}

