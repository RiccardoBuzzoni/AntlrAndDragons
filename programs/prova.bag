
creatures:

creature Warrior {
    known HP hp;

    //attacchi 'Damage' possono essere messi nella classe della creatura così oppure esterni come spell Damage SwordSlash() ..
    known Damage swordSlash() {
        Damage dmg = (Damage)roll 1d8;
        narrate i"Il guerriero usa Sword Slash! Il nemico subisce ${dmg} danni.";
        return dmg;
    }

    known Damage heavyStrike() {
        Damage dmg = (Damage)roll 2d6;
        narrate i"Il guerriero usa Heavy Strike! Il nemico subisce ${dmg} danni.";
        return dmg;
    }

    known Damage criticalStrike() {
        Damage dmg = (Damage)roll 1d12;
        narrate i"Il guerriero sferra un attacco critico: Critical Strike! Il nemico subisce ${dmg} danni.";
        return dmg;
    }
}


creature Goblin {
    known HP hp;

    known Damage clawAttack() {
        Damage dmg = (Damage)roll 1d4;
        narrate i"Il goblin sferra un attacco con i suoi artigli! Subisci ${dmg} danni.";
        return dmg;
    }
}


quest:
{
    narrate "Benvenuto avventuriero!\nTi diamo il benvenuto alla simulazione rpg con il nostro linguaggio: AntlrAndDragons!\n";

    narrate "Sei un guerriero appena arrivato in città, e subito ti viene incaricata una missione:\ndei goblin hanno attaccato il villagio, per favore aiutaci a farli scappare!";

    Warrior guerriero = summon Warrior();
    Goblin goblin = summon Goblin();

    guerriero.hp = (HP)40;
    goblin.hp= (HP)30;

    narrate "\nCorri verso il villaggio, fino a che non trovi il nemico davanti a te!\n1\n2\n3";
    narrate "=== BATTLE START ===";

    Int count = 1; //counter turni

    until ( (guerriero.hp lte 0) or (goblin.hp lte 0))
    {
        narrate "\n";
        narrate i"--- TURNO ${count} ---"; //\n non funziona nelle stringhe con i
        count ++;

        narrate "è il tuo turno:";

        Int result = roll d6;                                               //questo metodo di rollare era solo per avere un modo random per diversificare gli attacchi del guerriero, si può cambiare/togliere
        narrate i"result:${result} (controllo)";                            //per fare il check, togliere nella vers finale

        Damage WarriorATK = (Damage)0; //inizializzo WarriorATK a 0

        if ((result eq 1) or (result eq 2) or (result eq 3)) {          //else if non esiste
            WarriorATK = guerriero.cast swordSlash();
        }
        else {
            if ((result eq 4) or (result eq 5)) {
                WarriorATK = guerriero.cast heavyStrike();
            }
            else {
                WarriorATK = guerriero.cast criticalStrike();
            }
        }

        goblin.hp = goblin.hp - (HP)WarriorATK;
        narrate i"[goblin HP:${goblin.hp}]";

        if(goblin.hp lte 0)
        {
            narrate "\nIl goblin è stato sconfitto!";
            break;
        }

        narrate "\nè il turno del tuo nemico:";
        Damage goblinATK = goblin.cast clawAttack();
        guerriero.hp = guerriero.hp - (HP)goblinATK;
            narrate i"[Guerriero HP:${guerriero.hp}]";

        if(guerriero.hp lte 0)
        {
                narrate "\nSei stato sconfitto!";
                break;
        }
    }



}